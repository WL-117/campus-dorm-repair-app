/**
 * 模拟后端服务（Mock Server）
 * ------------------------------------------------------------------
 * 1. 内置「数据库」：用户表、工单表、公告表，数据持久化到 Storage，重启 App 不丢失
 * 2. 内置路由分发：按 method + url 匹配处理函数，完全遵循 RESTful 风格
 *    POST   /user/register      用户注册（新增）
 *    POST   /user/login         用户登录
 *    GET    /user/info          查询用户信息
 *    PUT    /user/update        修改用户信息（修改）
 *    GET    /repair/list        工单列表（分页 + 状态筛选 + 查询）
 *    GET    /repair/detail      工单详情
 *    POST   /repair/create      提交报修（新增）
 *    PUT    /repair/update      修改工单
 *    POST   /repair/cancel      取消报修
 *    DELETE /repair/delete      删除工单（删除）
 *    GET    /stat/mine          个人工单统计
 *    GET    /category/list      故障分类（常用数据）
 *    GET    /tips/list          常见故障提示
 *    GET    /notice/list        公告列表
 *    GET    /notice/detail      公告详情
 * 3. 统一返回 ApiResult：{ code, message, data }
 */
import { UserRecord, RepairOrder, OrderLog, Notice, ApiResult, DEFAULT_CATEGORIES } from './types.uts'
import {
	userToPlain, plainToUser, publicUser,
	orderToPlain, plainToOrder,
	noticeToPlain, plainToNotice,
	strVal, numVal, strArrayVal
} from './convert.uts'
import { isPhone, genId, genOrderNo, formatTime, nowTime, joinStr, splitStr } from './util.uts'

/* ------------------------------ 数据库（内存） ------------------------------ */

const KEY_USER_IDS = 'mock_db_user_ids'
const KEY_ORDER_IDS = 'mock_db_order_ids'
const KEY_NOTICE_IDS = 'mock_db_notice_ids'

let users : UserRecord[] = []
let orders : RepairOrder[] = []
let notices : Notice[] = []
let dbReady = false

function readStr(key : string) : string {
	const v = uni.getStorageSync(key)
	if (v == null) return ''
	return v as string
}

/** 逐条存储：单条记录是一个 JSON 对象，反序列化零风险 */
function saveRecords(prefix : string, indexKey : string, plains : UTSJSONObject[], ids : string[]) : void {
	for (let i = 0; i < plains.length; i++) {
		uni.setStorageSync(prefix + ids[i], JSON.stringify(plains[i]))
	}
	uni.setStorageSync(indexKey, joinStr(ids, ','))
}

function loadRecords(prefix : string, indexKey : string) : UTSJSONObject[] {
	const res : UTSJSONObject[] = []
	const ids = splitStr(readStr(indexKey), ',')
	for (let i = 0; i < ids.length; i++) {
		if (ids[i].length == 0) continue
		const s = readStr(prefix + ids[i])
		if (s.length == 0) continue
		res.push(JSON.parse(s) as UTSJSONObject)
	}
	return res
}

function saveUsers() : void {
	const plains : UTSJSONObject[] = []
	const ids : string[] = []
	for (let i = 0; i < users.length; i++) {
		plains.push(userToPlain(users[i]))
		ids.push(users[i].id)
	}
	saveRecords('mock_db_user_', KEY_USER_IDS, plains, ids)
}

function saveOrders() : void {
	const plains : UTSJSONObject[] = []
	const ids : string[] = []
	for (let i = 0; i < orders.length; i++) {
		plains.push(orderToPlain(orders[i]))
		ids.push(orders[i].id)
	}
	saveRecords('mock_db_order_', KEY_ORDER_IDS, plains, ids)
}

function saveNotices() : void {
	const plains : UTSJSONObject[] = []
	const ids : string[] = []
	for (let i = 0; i < notices.length; i++) {
		plains.push(noticeToPlain(notices[i]))
		ids.push(notices[i].id)
	}
	saveRecords('mock_db_notice_', KEY_NOTICE_IDS, plains, ids)
}

function loadUsers() : void {
	users = []
	const arr = loadRecords('mock_db_user_', KEY_USER_IDS)
	for (let i = 0; i < arr.length; i++) {
		users.push(plainToUser(arr[i]))
	}
}

function loadOrders() : void {
	orders = []
	const arr = loadRecords('mock_db_order_', KEY_ORDER_IDS)
	for (let i = 0; i < arr.length; i++) {
		orders.push(plainToOrder(arr[i]))
	}
}

function loadNotices() : void {
	notices = []
	const arr = loadRecords('mock_db_notice_', KEY_NOTICE_IDS)
	for (let i = 0; i < arr.length; i++) {
		notices.push(plainToNotice(arr[i]))
	}
}

function saveAll() : void {
	saveUsers()
	saveOrders()
	saveNotices()
}

/* -------------------------------- 初始化数据 -------------------------------- */

function buildLogs(status : string, hoursAgo : number) : OrderLog[] {
	const logs : OrderLog[] = []
	const t0 = formatTime(Date.now() - hoursAgo * 3600000)
	const l0 : OrderLog = { time: t0, content: '学生提交报修申请，等待宿管中心受理' }
	logs.push(l0)
	if (status == '1' || status == '2') {
		const l1 : OrderLog = { time: formatTime(Date.now() - (hoursAgo - 2) * 3600000), content: '宿管中心已受理，维修师傅已接单' }
		logs.push(l1)
	}
	if (status == '2') {
		const l2 : OrderLog = { time: formatTime(Date.now() - 1 * 3600000), content: '维修完成，请同学确认并评价' }
		logs.push(l2)
	}
	if (status == '3') {
		const l3 : OrderLog = { time: formatTime(Date.now() - (hoursAgo - 1) * 3600000), content: '学生主动取消该报修工单' }
		logs.push(l3)
	}
	return logs
}

function createSeedOrder(id : string, userId : string, userName : string, category : string, building : string, room : string, contact : string, description : string, level : string, status : string, hoursAgo : number) : RepairOrder {
	const o : RepairOrder = {
		id: id,
		orderNo: genOrderNo(),
		userId: userId,
		userName: userName,
		category: category,
		building: building,
		room: room,
		contact: contact,
		description: description,
		images: [],
		level: level,
		status: status,
		createTime: formatTime(Date.now() - hoursAgo * 3600000),
		updateTime: formatTime(Date.now() - Math.floor(hoursAgo / 2) * 3600000),
		remark: '',
		logs: buildLogs(status, hoursAgo)
	}
	return o
}

