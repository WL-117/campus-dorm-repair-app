/**
 * 通用工具方法：表单正则校验、时间处理、交互提示封装、字符串处理
 */

/** 手机号正则校验：1 开头，第二位 3~9，共 11 位数字 */
export function isPhone(phone : string) : boolean {
	const reg = new RegExp('^1[3-9]\\d{9}$')
	return reg.test(phone)
}

/** 账号校验：4~16 位字母、数字、下划线 */
export function isAccount(account : string) : boolean {
	const reg = new RegExp('^[a-zA-Z0-9_]{4,16}$')
	return reg.test(account)
}

/** 密码校验：6~18 位字母、数字、下划线 */
export function isPassword(pwd : string) : boolean {
	const reg = new RegExp('^[a-zA-Z0-9_]{6,18}$')
	return reg.test(pwd)
}

/** 纯数字校验（宿舍号等） */
export function isNumber(str : string) : boolean {
	const reg = new RegExp('^\\d+$')
	return reg.test(str)
}

/** 数字补零 */
export function pad2(n : number) : string {
	if (n < 10) return '0' + n.toString()
	return n.toString()
}

/** 时间戳转 yyyy-MM-dd HH:mm */
export function formatTime(ts : number) : string {
	const d = new Date(ts)
	return d.getFullYear().toString() + '-' + pad2(d.getMonth() + 1) + '-' + pad2(d.getDate()) + ' ' + pad2(d.getHours()) + ':' + pad2(d.getMinutes())
}

/** 当前时间字符串 */
export function nowTime() : string {
	return formatTime(Date.now())
}

/** 生成唯一 ID */
export function genId(prefix : string) : string {
	return prefix + Date.now().toString() + Math.floor(Math.random() * 10000).toString()
}

/** 生成工单编号：BX + 年月日时分秒 + 随机三位 */
export function genOrderNo() : string {
	const d = new Date()
	return 'BX' + d.getFullYear().toString() + pad2(d.getMonth() + 1) + pad2(d.getDate()) + pad2(d.getHours()) + pad2(d.getMinutes()) + pad2(d.getSeconds()) + Math.floor(Math.random() * 900 + 100).toString()
}

/** 数组按分隔符拼接（不依赖宿主 API，跨端稳定） */
export function joinStr(list : string[], sep : string) : string {
	let s = ''
	for (let i = 0; i < list.length; i++) {
		if (i > 0) s = s + sep
		s = s + list[i]
	}
	return s
}

/** 字符串按分隔符拆分 */
export function splitStr(text : string, sep : string) : string[] {
	const res : string[] = []
	if (text.length == 0) return res
	let rest = text
	let idx = rest.indexOf(sep)
	while (idx >= 0) {
		res.push(rest.substring(0, idx))
		rest = rest.substring(idx + sep.length)
		idx = rest.indexOf(sep)
	}
	res.push(rest)
	return res
}

/** 加载提示 */
export function showLoading(title : string) : void {
	uni.showLoading({
		title: title,
		mask: true
	})
}

/** 关闭加载提示 */
export function hideLoading() : void {
	uni.hideLoading()
}

/** 普通提示（失败 / 校验提示） */
export function toast(title : string) : void {
	uni.showToast({
		title: title,
		icon: 'none',
		duration: 1800
	})
}

/** 成功提示 */
export function successToast(title : string) : void {
	uni.showToast({
		title: title,
		icon: 'success',
		duration: 1500
	})
}

/** 二次确认弹窗（删除 / 取消报修等场景） */
export function confirmDialog(title : string, content : string) : Promise<boolean> {
	return new Promise<boolean>((resolve, reject) => {
		uni.showModal({
			title: title,
			content: content,
			confirmText: '确定',
			cancelText: '再想想',
			confirmColor: '#2b6cff',
			success: (res) => {
				resolve(res.confirm)
			}
		})
	})
}
