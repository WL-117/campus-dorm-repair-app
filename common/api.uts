/**
 * 业务接口层：一个函数对应一个 RESTful 接口，页面只与 api 层交互
 * 全部返回 Promise<ApiResult>，code == 0 表示业务成功
 */
import { ApiResult } from './types.uts'
import { request } from './http.uts'
import { getUserId } from './store.uts'

/* --------------------------------- 用户相关 --------------------------------- */

/** 注册：POST /user/register */
export function apiRegister(username : string, password : string, nickname : string, phone : string, gender : string, dorm : string) : Promise<ApiResult> {
	const p : UTSJSONObject = {
		'username': username,
		'password': password,
		'nickname': nickname,
		'phone': phone,
		'gender': gender,
		'dorm': dorm
	}
	return request('POST', '/user/register', p)
}

/** 登录：POST /user/login */
export function apiLogin(username : string, password : string) : Promise<ApiResult> {
	const p : UTSJSONObject = {
		'username': username,
		'password': password
	}
	return request('POST', '/user/login', p)
}

/** 查询用户信息：GET /user/info */
export function apiUserInfo(userId : string) : Promise<ApiResult> {
	const p : UTSJSONObject = { 'userId': userId }
	return request('GET', '/user/info', p)
}

/** 修改用户信息（昵称 / 头像 / 手机号 / 宿舍 / 性别）：PUT /user/update */
export function apiUpdateUser(nickname : string, phone : string, avatar : string, gender : string, dorm : string) : Promise<ApiResult> {
	const p : UTSJSONObject = {
		'userId': getUserId(),
		'nickname': nickname,
		'phone': phone,
		'avatar': avatar,
		'gender': gender,
		'dorm': dorm
	}
	return request('PUT', '/user/update', p)
}

/* --------------------------------- 工单相关 --------------------------------- */

/** 提交报修：POST /repair/create */
export function apiCreateOrder(category : string, building : string, room : string, contact : string, description : string, images : string[], level : string) : Promise<ApiResult> {
	const p : UTSJSONObject = {
		'userId': getUserId(),
		'category': category,
		'building': building,
		'room': room,
		'contact': contact,
		'description': description,
		'level': level
	}
	p['images'] = images
	return request('POST', '/repair/create', p)
}

/**
 * 工单列表：GET /repair/list
 * scope = 'all' 查询全部工单（报修大厅）；scope = 'mine' 只查当前登录用户（个人报修记录）
 */
export function apiOrderList(page : number, size : number, status : string, scope : string, keyword : string) : Promise<ApiResult> {
	const p : UTSJSONObject = {
		'page': page,
		'size': size,
		'status': status,
		'scope': scope,
		'keyword': keyword
	}
	if (scope == 'mine') p['userId'] = getUserId()
	return request('GET', '/repair/list', p)
}

/** 工单详情：GET /repair/detail */
export function apiOrderDetail(id : string) : Promise<ApiResult> {
	const p : UTSJSONObject = { 'id': id }
	return request('GET', '/repair/detail', p)
}

/** 修改工单：PUT /repair/update */
export function apiUpdateOrder(id : string, description : string, contact : string, room : string) : Promise<ApiResult> {
	const p : UTSJSONObject = {
		'id': id,
		'description': description,
		'contact': contact,
		'room': room
	}
	return request('PUT', '/repair/update', p)
}

/** 取消报修：POST /repair/cancel */
export function apiCancelOrder(id : string) : Promise<ApiResult> {
	const p : UTSJSONObject = {
		'id': id,
		'userId': getUserId()
	}
	return request('POST', '/repair/cancel', p)
}

/** 删除工单：DELETE /repair/delete */
export function apiDeleteOrder(id : string) : Promise<ApiResult> {
	const p : UTSJSONObject = {
		'id': id,
		'userId': getUserId()
	}
	return request('DELETE', '/repair/delete', p)
}

/** 个人工单统计：GET /stat/mine */
export function apiStat() : Promise<ApiResult> {
	const p : UTSJSONObject = { 'userId': getUserId() }
	return request('GET', '/stat/mine', p)
}

