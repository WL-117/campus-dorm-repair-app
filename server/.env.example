# ------------------------------------------------------------
# 校园宿舍线上报修 APP —— 后端环境变量模板
# 复制本文件为 .env 后按自己的环境填写（.env 已被 .gitignore 忽略，不会提交）
#   Windows:  copy .env.example .env
#   macOS/Linux: cp .env.example .env
# ------------------------------------------------------------

# 服务端口（默认 3000）
PORT=3000

# 监听地址（0.0.0.0 允许手机 / 模拟器通过局域网访问）
HOST=0.0.0.0

# MySQL 连接配置
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-password
DB_NAME=dorm_repair

# 连接池大小
DB_POOL=10
