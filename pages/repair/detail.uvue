<template>
	<!-- #ifdef APP && !VUE3-VAPOR -->
	<scroll-view class="page-scroll" :scroll-y="true" :bounces="false">
	<!-- #endif -->

	<view class="page">
		<!-- 状态横幅 -->
		<view :class="bannerClass">
			<text class="banner-title">{{statusText}}</text>
			<text class="banner-desc">{{statusDesc}}</text>
		</view>

		<!-- 工单信息 -->
		<view class="card">
			<text class="card-title">工单信息</text>
			<view class="row">
				<text class="label">工单编号</text>
				<text class="value">{{order.orderNo}}</text>
			</view>
			<view class="row">
				<text class="label">故障分类</text>
				<text class="value">{{order.category}}</text>
			</view>
			<view class="row">
				<text class="label">报修宿舍</text>
				<text class="value">{{order.building}}-{{order.room}}</text>
			</view>
			<view class="row">
				<text class="label">联系人</text>
				<text class="value">{{order.userName}}　{{order.contact}}</text>
			</view>
			<view class="row">
				<text class="label">紧急程度</text>
				<text class="value">{{order.level}}</text>
			</view>
			<view class="row">
				<text class="label">提交时间</text>
				<text class="value">{{order.createTime}}</text>
			</view>
			<view class="row">
				<text class="label">更新时间</text>
				<text class="value">{{order.updateTime}}</text>
			</view>
		</view>

		<!-- 故障描述 -->
		<view class="card">
			<text class="card-title">故障描述</text>
			<text class="desc">{{order.description}}</text>
			<view class="img-wrap" v-if="order.images.length > 0">
				<image class="img" v-for="(item, index) in order.images" :key="index" :src="item" mode="aspectFill" @click="previewImage(index)"></image>
			</view>
			<text class="no-img" v-else>同学未上传现场照片</text>
		</view>

		<!-- 处理进度 -->
		<view class="card">
			<text class="card-title">处理进度</text>
			<view class="log" v-for="(item, index) in order.logs" :key="index">
				<view class="log-line">
					<view class="dot" :class="index == 0 ? 'dot-on' : ''"></view>
				</view>
				<view class="log-body">
					<text class="log-content">{{item.content}}</text>
					<text class="log-time">{{item.time}}</text>
				</view>
			</view>
			<view class="empty-log" v-if="order.logs.length == 0">
				<text class="empty-log-text">暂无进度记录</text>
			</view>
		</view>

		<view class="bottom-space"></view>

		<!-- 底部操作 -->
		<view class="footer" v-if="order.id.length > 0">
			<view class="btn-plain" @click="onCancel" v-if="order.status == '0'">
				<text class="btn-plain-text">取消报修</text>
			</view>
			<view class="btn-danger" @click="onDelete" v-if="order.status == '2' || order.status == '3'">
				<text class="btn-danger-text">删除记录</text>
			</view>
			<view class="btn-primary" @click="goBack">
				<text class="btn-primary-text">返回列表</text>
			</view>
		</view>
	</view>

	<!-- #ifdef APP && !VUE3-VAPOR -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { apiOrderDetail, apiCancelOrder, apiDeleteOrder } from '../../common/api.uts'
	import { ApiResult, RepairOrder } from '../../common/types.uts'
	import { plainToOrder } from '../../common/convert.uts'
	import { toast, successToast, showLoading, hideLoading, confirmDialog } from '../../common/util.uts'
	import { markRefresh } from '../../common/store.uts'

	function emptyOrder() : RepairOrder {
		const o : RepairOrder = {
			id: '',
			orderNo: '',
			userId: '',
			userName: '',
			category: '',
			building: '',
			room: '',
			contact: '',
			description: '',
			images: [],
			level: '',
			status: '0',
			createTime: '',
			updateTime: '',
			remark: '',
			logs: []
		}
		return o
	}

	const order = ref<RepairOrder>(emptyOrder())
	const statusText = ref('待处理')
	const statusDesc = ref('')
	const bannerClass = ref('banner banner-0')

	onLoad((options : OnLoadOptions) => {
		const id = (options['id'] ?? '') as string
		if (id.length == 0) {
			toast('缺少工单参数')
			return
		}
		order.value.id = id
		loadDetail()
	})

	function loadDetail() : void {
		showLoading('加载中')
		apiOrderDetail(order.value.id).then((res : ApiResult) => {
			hideLoading()
			if (res.code != 0) {
				toast(res.message)
				return
			}
			const o = plainToOrder(res.data as UTSJSONObject)
			order.value = o
			renderStatus(o.status)
		})
	}

	function renderStatus(status : string) : void {
		if (status == '0') {
			statusText.value = '待处理'
			statusDesc.value = '工单已提交，宿管中心正在受理，请耐心等待'
			bannerClass.value = 'banner banner-0'
		} else if (status == '1') {
			statusText.value = '维修中'
			statusDesc.value = '维修师傅已接单，正在处理中'
			bannerClass.value = 'banner banner-1'
		} else if (status == '2') {
			statusText.value = '已完成'
			statusDesc.value = '本次报修已处理完成，感谢你的反馈'
			bannerClass.value = 'banner banner-2'
		} else {
			statusText.value = '已取消'
			statusDesc.value = '该工单已取消，如需维修请重新提交'
			bannerClass.value = 'banner banner-3'
		}
	}

	function previewImage(index : number) : void {
		uni.previewImage({
			current: index,
			urls: order.value.images
		})
	}

	function onCancel() : void {
		confirmDialog('取消报修', '取消后工单将不再受理，确定取消吗？').then((confirm : boolean) => {
			if (!confirm) return
			showLoading('处理中')
			apiCancelOrder(order.value.id).then((res : ApiResult) => {
				hideLoading()
				if (res.code != 0) {
					toast(res.message)
					return
				}
				markRefresh()
				successToast('已取消报修')
				loadDetail()
			})
		})
	}

	function onDelete() : void {
		confirmDialog('删除工单', '删除后不可恢复，确定删除该报修记录吗？').then((confirm : boolean) => {
			if (!confirm) return
			showLoading('删除中')
			apiDeleteOrder(order.value.id).then((res : ApiResult) => {
				hideLoading()
				if (res.code != 0) {
					toast(res.message)
					return
				}
				markRefresh()
				successToast('删除成功')
				setTimeout(() => {
					uni.navigateBack()
				}, 700)
			})
		})
	}

	function goBack() : void {
		uni.navigateBack()
	}
</script>

<style>
	page {
		background-color: #f4f6fa;
	}

	.page {
		flex-direction: column;
		background-color: #f4f6fa;
	}

	.banner {
		padding: 40rpx 30rpx;
		flex-direction: column;
	}

	.banner-0 {
		background-color: #ff8f1f;
	}

	.banner-1 {
		background-color: #2b6cff;
	}

	.banner-2 {
		background-color: #18a058;
	}

	.banner-3 {
		background-color: #9aa0a6;
	}

	.banner-title {
		font-size: 40rpx;
		color: #ffffff;
		font-weight: bold;
	}

	.banner-desc {
		margin-top: 12rpx;
		font-size: 24rpx;
		color: #ffffff;
	}

	.card {
		margin: 20rpx 24rpx 0 24rpx;
		padding: 26rpx;
		border-radius: 18rpx;
		background-color: #ffffff;
		flex-direction: column;
	}

	.card-title {
		font-size: 29rpx;
		color: #1f2329;
		font-weight: bold;
		margin-bottom: 18rpx;
	}

	.row {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
		padding: 14rpx 0;
	}

	.label {
		font-size: 26rpx;
		color: #8a94a6;
	}

	.value {
		font-size: 26rpx;
		color: #1f2329;
	}

	.desc {
		font-size: 26rpx;
		color: #4b5563;
		line-height: 40rpx;
	}

	.img-wrap {
		margin-top: 20rpx;
		flex-direction: row;
		flex-wrap: wrap;
	}

	.img {
		width: 200rpx;
		height: 200rpx;
		border-radius: 12rpx;
		margin-right: 16rpx;
		margin-bottom: 16rpx;
	}

	.no-img {
		margin-top: 16rpx;
		font-size: 24rpx;
		color: #b6bdc9;
	}

	.log {
		flex-direction: row;
	}

	.log-line {
		width: 40rpx;
		align-items: center;
	}

	.dot {
		width: 18rpx;
		height: 18rpx;
		border-radius: 9rpx;
		background-color: #d8dde5;
		margin-top: 12rpx;
	}

	.dot-on {
		background-color: #2b6cff;
	}

	.log-body {
		flex: 1;
		padding-bottom: 30rpx;
		border-left-width: 2rpx;
		border-left-color: #eef0f4;
		border-left-style: solid;
		padding-left: 20rpx;
		flex-direction: column;
	}

	.log-content {
		font-size: 26rpx;
		color: #1f2329;
		line-height: 38rpx;
	}

	.log-time {
		margin-top: 8rpx;
		font-size: 22rpx;
		color: #9aa0a6;
	}

	.empty-log {
		padding: 20rpx 0;
	}

	.empty-log-text {
		font-size: 24rpx;
		color: #b6bdc9;
	}

	.bottom-space {
		height: 160rpx;
	}

	.footer {
		position: fixed;
		left: 0;
		right: 0;
		bottom: 0;
		height: 120rpx;
		background-color: #ffffff;
		flex-direction: row;
		align-items: center;
		justify-content: flex-end;
		padding-right: 24rpx;
		border-top-width: 1rpx;
		border-top-color: #f0f1f4;
		border-top-style: solid;
	}

	.btn-plain {
		padding: 0 40rpx;
		height: 76rpx;
		border-radius: 38rpx;
		border-width: 2rpx;
		border-color: #c8ced9;
		border-style: solid;
		justify-content: center;
		align-items: center;
		margin-right: 20rpx;
	}

	.btn-plain-text {
		font-size: 27rpx;
		color: #6b7280;
	}

	.btn-danger {
		padding: 0 40rpx;
		height: 76rpx;
		border-radius: 38rpx;
		border-width: 2rpx;
		border-color: #ff4d4f;
		border-style: solid;
		justify-content: center;
		align-items: center;
		margin-right: 20rpx;
	}

	.btn-danger-text {
		font-size: 27rpx;
		color: #ff4d4f;
	}

	.btn-primary {
		padding: 0 50rpx;
		height: 76rpx;
		border-radius: 38rpx;
		background-color: #2b6cff;
		justify-content: center;
		align-items: center;
	}

	.btn-primary-text {
		font-size: 27rpx;
		color: #ffffff;
	}
	/* ---------------- 视觉优化 ---------------- */
	.card {
		border-radius: 24rpx;
	}

	.banner {
		padding: 40rpx 30rpx 36rpx 30rpx;
	}

	.btn-primary {
		border-radius: 44rpx;
		background-image: linear-gradient(to right, #2b6cff, #5f92ff);
	}

	.btn-danger {
		border-radius: 44rpx;
	}

	.btn-plain {
		border-radius: 44rpx;
	}

	.footer {
		padding: 20rpx 24rpx 40rpx 24rpx;
	}
</style>
