<template>
	<!-- #ifdef APP && !VUE3-VAPOR -->
	<scroll-view class="page-scroll" :scroll-y="true" :bounces="false">
	<!-- #endif -->

	<view class="page">
		<!-- 草稿提示 -->
		<view class="draft-bar" v-if="showDraftTip" @click="restoreDraft">
			<text class="draft-text">检测到上次未提交的报修草稿，点击恢复</text>
			<text class="draft-btn">恢复</text>
		</view>

		<!-- 故障分类 -->
		<view class="card">
			<view class="card-head">
				<text class="card-title">故障分类</text>
				<text class="required">*</text>
			</view>
			<view class="tag-wrap">
				<view class="tag" :class="category == item ? 'tag-on' : ''" v-for="(item, index) in categories" :key="index" @click="category = item">
					<text class="tag-text" :class="category == item ? 'tag-text-on' : ''">{{item}}</text>
				</view>
			</view>
		</view>

		<!-- 宿舍与联系方式 -->
		<view class="card">
			<view class="card-head">
				<text class="card-title">报修信息</text>
			</view>
			<view class="field">
				<text class="field-label">宿舍楼栋</text>
				<input class="field-input" v-model="building" placeholder="如：A栋" placeholder-class="ph" maxlength="10" />
			</view>
			<view class="field">
				<text class="field-label">宿舍号</text>
				<input class="field-input" v-model="room" type="number" placeholder="如：305" placeholder-class="ph" maxlength="5" />
			</view>
			<view class="field">
				<text class="field-label">联系手机</text>
				<input class="field-input" v-model="contact" type="number" placeholder="请输入 11 位手机号" placeholder-class="ph" maxlength="11" />
			</view>
			<view class="field">
				<text class="field-label">紧急程度</text>
				<view class="level-row">
					<view class="level" :class="level == item ? 'level-on' : ''" v-for="(item, index) in levels" :key="index" @click="level = item">
						<text class="level-text" :class="level == item ? 'level-text-on' : ''">{{item}}</text>
					</view>
				</view>
			</view>
		</view>

		<!-- 故障描述 -->
		<view class="card">
			<view class="card-head">
				<text class="card-title">故障描述</text>
				<text class="counter">{{description.length}}/200</text>
			</view>
			<textarea class="textarea" v-model="description" placeholder="请简单描述故障现象、出现时间等，便于维修师傅快速定位（不少于 5 个字）" placeholder-class="ph" :maxlength="200" />
		</view>

		<!-- 图片上传 -->
		<view class="card">
			<view class="card-head">
				<text class="card-title">现场照片</text>
				<text class="counter">{{images.length}}/3</text>
			</view>
			<view class="img-wrap">
				<view class="img-item" v-for="(item, index) in images" :key="index">
					<image class="img" :src="item" mode="aspectFill" @click="previewImage(index)"></image>
					<view class="img-del" @click="removeImage(index)">
						<text class="img-del-text">×</text>
					</view>
				</view>
				<view class="img-add" v-if="images.length < 3" @click="chooseImage">
					<text class="add-plus">+</text>
					<text class="add-text">上传照片</text>
				</view>
			</view>
		</view>

		<view class="btn-submit" @click="onSubmit">
			<text class="btn-submit-text">提交报修工单</text>
		</view>
		<text class="tips">提交后可在「我的报修」中查看处理进度</text>
	</view>

	<!-- #ifdef APP && !VUE3-VAPOR -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { apiCreateOrder } from '../../common/api.uts'
	import { ApiResult, LEVELS } from '../../common/types.uts'
	import { strVal } from '../../common/convert.uts'
	import { isPhone, toast, successToast, showLoading, hideLoading, confirmDialog, joinStr, splitStr } from '../../common/util.uts'
	import { getUser, isLogin, getCategories, getDraft, saveDraft, clearDraft, hasDraft, markRefresh } from '../../common/store.uts'

	const levels : string[] = LEVELS

	const categories = ref<string[]>([])
	const category = ref('')
	const building = ref('')
	const room = ref('')
	const contact = ref('')
	const description = ref('')
	const level = ref('普通')
	const images = ref<string[]>([])
	const showDraftTip = ref(false)

	let draftCache : UTSJSONObject = {}
	let submitted = false

	onLoad((options : OnLoadOptions) => {
		if (!isLogin()) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return
		}
		// 故障分类：优先使用本地缓存的常用数据
		const cached = getCategories()
		const list : string[] = []
		for (let i = 0; i < cached.length; i++) {
			list.push(cached[i])
		}
		categories.value = list

		// 用个人信息预填联系方式与宿舍，减少重复输入
		const u = getUser()
		if (u.phone.length > 0) contact.value = u.phone
		if (u.dorm.length > 0) {
			const parts = splitStr(u.dorm, '-')
			building.value = parts[0]
			if (parts.length > 1) room.value = parts[1]
		}

		if (hasDraft()) {
			draftCache = getDraft()
			showDraftTip.value = true
		}
	})

	onUnload(() => {
		// 离开页面时自动保存草稿到本地缓存（提交成功则不保存）
		if (!submitted && (description.value.length > 0 || category.value.length > 0)) {
			const d : UTSJSONObject = {
				'category': category.value,
				'building': building.value,
				'room': room.value,
				'contact': contact.value,
				'description': description.value,
				'level': level.value,
				'images': joinStr(images.value, ',')
			}
			saveDraft(d)
		}
	})

	function restoreDraft() : void {
		category.value = strVal(draftCache, 'category')
		building.value = strVal(draftCache, 'building')
		room.value = strVal(draftCache, 'room')
		contact.value = strVal(draftCache, 'contact')
		description.value = strVal(draftCache, 'description')
		level.value = strVal(draftCache, 'level')
		images.value = splitStr(strVal(draftCache, 'images'), ',')
		showDraftTip.value = false
		toast('草稿已恢复')
	}

	function chooseImage() : void {
		const left = 3 - images.value.length
		if (left <= 0) {
			toast('最多上传 3 张照片')
			return
		}
		uni.chooseImage({
			count: left,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				const paths = res.tempFilePaths
				const cur = images.value
				for (let i = 0; i < paths.length; i++) {
					if (cur.length < 3) cur.push(paths[i])
				}
				images.value = cur
			}
		})
	}

	function removeImage(index : number) : void {
		confirmDialog('删除照片', '确定删除这张照片吗？').then((confirm : boolean) => {
			if (!confirm) return
			const next : string[] = []
			const cur = images.value
			for (let i = 0; i < cur.length; i++) {
				if (i != index) next.push(cur[i])
			}
			images.value = next
		})
	}

	function previewImage(index : number) : void {
		uni.previewImage({
			current: index,
			urls: images.value
		})
	}

	function onSubmit() : void {
		if (category.value.length == 0) {
			toast('请选择故障分类')
			return
		}
		if (building.value.length == 0) {
			toast('请输入宿舍楼栋')
			return
		}
		if (room.value.length == 0) {
			toast('请输入宿舍号')
			return
		}
		if (!isPhone(contact.value)) {
			toast('请输入正确的 11 位手机号')
			return
		}
		if (description.value.length < 5) {
			toast('故障描述不少于 5 个字')
			return
		}

		showLoading('提交中')
		apiCreateOrder(category.value, building.value, room.value, contact.value, description.value, images.value, level.value).then((res : ApiResult) => {
			hideLoading()
			if (res.code != 0) {
				toast(res.message)
				return
			}
			const order = res.data as UTSJSONObject
			const orderId = strVal(order, 'id')
			submitted = true
			clearDraft()
			markRefresh()
			successToast('提交成功')
			setTimeout(() => {
				uni.redirectTo({
					url: '/pages/repair/detail?id=' + orderId
				})
			}, 700)
		})
	}
</script>

