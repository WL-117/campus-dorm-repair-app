		background-color: #ffffff;
	}

	.tabs {
		padding: 0 12rpx;
		background-color: #ffffff;
		border-bottom-width: 1rpx;
		border-bottom-color: #f0f1f4;
		border-bottom-style: solid;
	}

	.tab {
		height: 88rpx;
		flex-direction: column;
		justify-content: center;
		align-items: center;
	}

	.tab-text {
		font-size: 26rpx;
		color: #6b7280;
	}

	.tab-text-on {
		font-size: 27rpx;
		font-weight: bold;
		color: #2b6cff;
	}

	.order-card {
		border-radius: 24rpx;
		box-shadow: 0 6rpx 20rpx rgba(31, 35, 41, 0.05);
	}

	.empty {
		margin: 40rpx 24rpx;
		padding: 70rpx 0;
