<template>
	<!-- #ifdef APP && !VUE3-VAPOR -->
	<scroll-view class="page-scroll" :scroll-y="true" :bounces="false">
	<!-- #endif -->

	<view class="page">
		<!-- 个人工单概览 -->
		<view class="header">
			<view class="header-row">
				<view class="avatar">
					<image class="avatar-img" v-if="avatar.length > 0" :src="avatar" mode="aspectFill"></image>
					<text class="avatar-text" v-else>{{avatarText}}</text>
				</view>
				<view class="user-info">
					<text class="nickname">{{nickname}}</text>
					<text class="dorm">{{dormText}}</text>
				</view>
			</view>
			<view class="stat-row">
				<view class="stat-item">
					<text class="stat-num">{{total}}</text>
					<text class="stat-label">全部</text>
				</view>
				<view class="stat-item">
					<text class="stat-num color-pending">{{pending}}</text>
					<text class="stat-label">待处理</text>
				</view>
				<view class="stat-item">
					<text class="stat-num color-doing">{{doing}}</text>
					<text class="stat-label">维修中</text>
				</view>
				<view class="stat-item">
					<text class="stat-num color-done">{{done}}</text>
					<text class="stat-label">已完成</text>
				</view>
				<view class="stat-item">
					<text class="stat-num color-cancel">{{canceled}}</text>
					<text class="stat-label">已取消</text>
				</view>
			</view>
		</view>

		<!-- 状态筛选 -->
		<view class="tabs">
			<view class="tab" :class="tabIndex == index ? 'tab-on' : ''" v-for="(item, index) in tabs" :key="index" @click="switchTab(index)">
				<text class="tab-text" :class="tabIndex == index ? 'tab-text-on' : ''">{{item}}</text>
			</view>
		</view>

		<!-- 我的工单 -->
		<view class="list">
			<view class="order-card" v-for="(item, index) in list" :key="item.id" @click="goDetail(item.id)">
				<view class="order-top">
					<text class="order-no">{{item.orderNo}}</text>
					<view :class="statusClass(item.status)">
						<text :class="statusTextClass(item.status)">{{statusText(item.status)}}</text>
					</view>
				</view>
				<text class="order-title">{{item.category}} · {{item.building}}-{{item.room}}</text>
				<text class="order-desc">{{item.description}}</text>
				<view class="order-bottom">
					<text class="order-time">{{item.createTime}}</text>
					<text class="order-link">查看详情 ›</text>
				</view>
			</view>
		</view>

		<view class="loading-more" v-if="list.length > 0">
			<text class="loading-text" v-if="hasMore">上拉加载更多</text>
			<text class="loading-text" v-else>没有更多工单了</text>
		</view>
		<view class="empty" v-if="list.length == 0 && !loading">
			<view class="empty-icon">
				<text class="empty-icon-text">单</text>
			</view>
			<text class="empty-text">你还没有相关报修记录</text>
			<view class="empty-btn" @click="goCreate">
				<text class="empty-btn-text">立即报修</text>
			</view>
		</view>
	</view>

	<!-- #ifdef APP && !VUE3-VAPOR -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { apiOrderList, apiStat } from '../../common/api.uts'
	import {
		ApiResult, RepairOrder, STATUS_TABS, STATUS_TAB_NAMES, statusText
	} from '../../common/types.uts'
	import { plainToOrder, arrayVal, numVal, boolVal } from '../../common/convert.uts'
	import { toast, showLoading, hideLoading } from '../../common/util.uts'
	import { getUser, isLogin, takeRefresh } from '../../common/store.uts'

	const PAGE_SIZE = 6
	const tabs : string[] = STATUS_TAB_NAMES

	const list = ref<RepairOrder[]>([])
	const tabIndex = ref(0)
	const pageNo = ref(1)
	const hasMore = ref(true)
	const loading = ref(false)

	const total = ref(0)
	const pending = ref(0)
	const doing = ref(0)
	const done = ref(0)
	const canceled = ref(0)

	const nickname = ref('我')
	const avatarText = ref('我')
	const avatar = ref('')
	const dormText = ref('')

	onLoad((options : OnLoadOptions) => {
		if (!isLogin()) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return
		}
		// 页面间参数传递：首页点击统计卡片时携带 status
		const status = (options['status'] ?? '') as string
		for (let i = 0; i < STATUS_TABS.length; i++) {
			if (STATUS_TABS[i] == status) tabIndex.value = i
		}
		loadUser()
		loadStat()
		loadData(true)
	})

	onPageShow(() => {
		if (takeRefresh()) {
			loadStat()
			loadData(true)
		}
	})

	onPullDownRefresh(() => {
		loadStat()
		loadData(true)
	})

	onReachBottom(() => {
		if (!hasMore.value) return
		loadData(false)
	})

	function loadUser() : void {
		const u = getUser()
		nickname.value = u.nickname.length > 0 ? u.nickname : u.username
		avatar.value = u.avatar
		dormText.value = u.dorm.length > 0 ? u.dorm : '未填写宿舍'
		avatarText.value = nickname.value.substring(0, 1)
	}

	function loadStat() : void {
		apiStat().then((res : ApiResult) => {
			if (res.code != 0) return
			const d = res.data as UTSJSONObject
			total.value = numVal(d, 'total')
			pending.value = numVal(d, 'pending')
			doing.value = numVal(d, 'doing')
			done.value = numVal(d, 'done')
			canceled.value = numVal(d, 'canceled')
		})
	}

	function loadData(reset : boolean) : void {
		if (loading.value) return
		if (reset) {
			pageNo.value = 1
			hasMore.value = true
		}
		loading.value = true
		if (reset) showLoading('加载中')

		apiOrderList(pageNo.value, PAGE_SIZE, STATUS_TABS[tabIndex.value], 'mine', '').then((res : ApiResult) => {
			loading.value = false
			hideLoading()
			uni.stopPullDownRefresh()
			if (res.code != 0) {
				toast(res.message)
				return
			}
			const d = res.data as UTSJSONObject
			const arr = arrayVal(d, 'list')
			const pageList : RepairOrder[] = []
			for (let i = 0; i < arr.length; i++) {
				pageList.push(plainToOrder(arr[i]))
			}
			if (reset) {
				list.value = pageList
			} else {
				const cur = list.value
				for (let i = 0; i < pageList.length; i++) {
					cur.push(pageList[i])
				}
				list.value = cur
			}
			hasMore.value = boolVal(d, 'hasMore')
			if (hasMore.value) pageNo.value = pageNo.value + 1
		})
	}

	function switchTab(index : number) : void {
		if (tabIndex.value == index) return
		tabIndex.value = index
		loadData(true)
	}

	function statusClass(status : string) : string {
		if (status == '0') return 'status status-0'
		if (status == '1') return 'status status-1'
		if (status == '2') return 'status status-2'
		return 'status status-3'
	}

	function statusTextClass(status : string) : string {
		if (status == '0') return 'status-text text-0'
		if (status == '1') return 'status-text text-1'
		if (status == '2') return 'status-text text-2'
		return 'status-text text-3'
	}

	function goDetail(id : string) : void {
		uni.navigateTo({
			url: '/pages/repair/detail?id=' + id
		})
	}

	function goCreate() : void {
		uni.navigateTo({
			url: '/pages/repair/create'
		})
	}
</script>

<style>
	page {
		background-color: #f4f6fa;
	}

	.page {
		flex-direction: column;
		background-color: #f4f6fa;
		padding-bottom: 30rpx;
