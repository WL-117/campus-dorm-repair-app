		color: #9aa0a6;
	}

	.empty {
		margin-top: 100rpx;
		flex-direction: column;
		align-items: center;
	}

	.empty-icon {
		width: 120rpx;
		height: 120rpx;
		border-radius: 60rpx;
		background-color: #eef1f6;
		color: #b6bdc9;
