	}

	.list {
		margin-top: 20rpx;
		padding: 0 24rpx;
	}

	.order-card {
		margin-bottom: 20rpx;
		padding: 26rpx;
		border-radius: 18rpx;
		background-color: #ffffff;
		flex-direction: column;
	}

	.order-top {
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.order-no {
		font-size: 24rpx;
		color: #8a94a6;
	}

	.status {
		padding: 6rpx 18rpx;
		border-radius: 20rpx;
	}

	.status-0 {
		background-color: #fff3e5;
	}

	.status-1 {
		background-color: #e8f0ff;
	}

	.status-2 {
		background-color: #e8f7ee;
	}

	.status-3 {
		background-color: #f0f1f3;
	}

	.status-text {
		font-size: 22rpx;
		font-weight: bold;
	}

	.text-0 {
		color: #ff8f1f;
	}

	.text-1 {
		color: #2b6cff;
	}

	.text-2 {
		color: #18a058;
	}

	.text-3 {
		color: #9aa0a6;
	}

	.order-title {
		margin-top: 16rpx;
		font-size: 30rpx;
		color: #1f2329;
		font-weight: bold;
	}

	.order-desc {
		margin-top: 12rpx;
		font-size: 25rpx;
		color: #6b7280;
		line-height: 38rpx;
	}

	.order-bottom {
		margin-top: 18rpx;
		flex-direction: row;
		align-items: center;
		justify-content: space-between;
	}

	.order-time {
		font-size: 23rpx;
