		font-weight: bold;
	}

	.color-pending {
		color: #ffd39b;
	}

	.color-doing {
		color: #c7daff;
	}

	.color-done {
		color: #b7ebc8;
	}

	.color-cancel {
		color: #e5e8ee;
	}

	.stat-label {
		margin-top: 6rpx;
		font-size: 22rpx;
		color: #d9e4ff;
	}

	.tabs {
		margin: 20rpx 24rpx 0 24rpx;
		flex-direction: row;
		align-items: center;
	}

	.tab {
		flex: 1;
		height: 68rpx;
		margin-right: 12rpx;
		border-radius: 34rpx;
		background-color: #ffffff;
		justify-content: center;
		align-items: center;
	}

