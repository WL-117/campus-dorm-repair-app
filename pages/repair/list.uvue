<template>
	<!-- #ifdef APP && !VUE3-VAPOR -->
	<scroll-view class="page-scroll" :scroll-y="true" :bounces="false">
	<!-- #endif -->

	<view class="page">
		<!-- 搜索 -->
		<view class="search-bar">
			<input class="search-input" v-model="keyword" placeholder="搜索工单号 / 故障分类 / 描述" placeholder-class="ph" confirm-type="search" @confirm="onSearch" />
			<view class="search-btn" @click="onSearch">
				<text class="search-btn-text">搜索</text>
			</view>
		</view>

		<!-- 状态筛选 -->
		<view class="tabs">
			<view class="tab" :class="tabIndex == index ? 'tab-on' : ''" v-for="(item, index) in tabs" :key="index" @click="switchTab(index)">
				<text class="tab-text" :class="tabIndex == index ? 'tab-text-on' : ''">{{item}}</text>
			</view>
		</view>

		<!-- 工单列表 -->
		<view class="list">
			<view class="order-card" v-for="(item, index) in list" :key="item.id" @click="goDetail(item.id)">
				<view class="order-top">
					<text class="order-no">{{item.orderNo}}</text>
					<view :class="statusClass(item.status)">
						<text :class="statusTextClass(item.status)">{{statusText(item.status)}}</text>
					</view>
				</view>
				<text class="order-title">{{item.category}} · {{item.building}}-{{item.room}}</text>
				<text class="order-desc">{{item.description}}</text>
				<view class="order-bottom">
					<text class="order-user">{{item.userName}}　{{item.contact}}</text>
					<text class="order-time">{{item.createTime}}</text>
				</view>
				<view class="order-extra" v-if="item.level == '紧急' || item.images.length > 0">
					<text class="level-tag" v-if="item.level == '紧急'">紧急</text>
					<text class="img-tag" v-if="item.images.length > 0">{{item.images.length}} 张照片</text>
				</view>
			</view>
		</view>

		<!-- 加载更多 / 空状态 -->
		<view class="loading-more" v-if="list.length > 0">
			<text class="loading-text" v-if="hasMore">上拉加载更多</text>
			<text class="loading-text" v-else>没有更多工单了</text>
		</view>
		<view class="empty" v-if="list.length == 0 && !loading">
			<view class="empty-icon">
				<text class="empty-icon-text">单</text>
			</view>
			<text class="empty-text">暂无相关报修工单</text>
			<view class="empty-btn" @click="goCreate">
				<text class="empty-btn-text">去报修</text>
			</view>
		</view>
	</view>

	<!-- #ifdef APP && !VUE3-VAPOR -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { apiOrderList } from '../../common/api.uts'
	import {
		ApiResult, RepairOrder, STATUS_TABS, STATUS_TAB_NAMES, statusText
	} from '../../common/types.uts'
	import { plainToOrder, arrayVal, numVal, boolVal } from '../../common/convert.uts'
	import { toast, showLoading, hideLoading } from '../../common/util.uts'
	import { isLogin, takeRefresh } from '../../common/store.uts'

	const PAGE_SIZE = 6

	const tabs : string[] = STATUS_TAB_NAMES

	const list = ref<RepairOrder[]>([])
	const tabIndex = ref(0)
	const keyword = ref('')
	const pageNo = ref(1)
	const hasMore = ref(true)
	const loading = ref(false)
	const total = ref(0)

	onLoad((options : OnLoadOptions) => {
		if (!isLogin()) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return
		}
		loadData(true)
	})

	onPageShow(() => {
		// 详情页发生变更（取消 / 删除）后自动刷新列表
		if (takeRefresh()) {
			loadData(true)
		}
	})

	onPullDownRefresh(() => {
		loadData(true)
	})

	onReachBottom(() => {
		if (!hasMore.value) return
		loadData(false)
	})

	function loadData(reset : boolean) : void {
		if (loading.value) return
		if (reset) {
			pageNo.value = 1
			hasMore.value = true
		}
		loading.value = true
		if (reset) showLoading('加载中')

		apiOrderList(pageNo.value, PAGE_SIZE, STATUS_TABS[tabIndex.value], 'all', keyword.value).then((res : ApiResult) => {
			loading.value = false
			hideLoading()
			uni.stopPullDownRefresh()
			if (res.code != 0) {
				toast(res.message)
				return
			}
			const d = res.data as UTSJSONObject
			const arr = arrayVal(d, 'list')
			const pageList : RepairOrder[] = []
			for (let i = 0; i < arr.length; i++) {
				pageList.push(plainToOrder(arr[i]))
			}
			if (reset) {
				list.value = pageList
			} else {
				const cur = list.value
				for (let i = 0; i < pageList.length; i++) {
					cur.push(pageList[i])
				}
				list.value = cur
			}
			total.value = numVal(d, 'total')
			hasMore.value = boolVal(d, 'hasMore')
			if (hasMore.value) pageNo.value = pageNo.value + 1
		})
	}

	function statusClass(status : string) : string {
		if (status == '0') return 'status status-0'
		if (status == '1') return 'status status-1'
		if (status == '2') return 'status status-2'
		return 'status status-3'
	}

	function statusTextClass(status : string) : string {
		if (status == '0') return 'status-text text-0'
		if (status == '1') return 'status-text text-1'
		if (status == '2') return 'status-text text-2'
		return 'status-text text-3'
	}

	function switchTab(index : number) : void {
		if (tabIndex.value == index) return
		tabIndex.value = index
		loadData(true)
	}

	function onSearch() : void {
		loadData(true)
	}

	function goDetail(id : string) : void {
		uni.navigateTo({
			url: '/pages/repair/detail?id=' + id
		})
	}

	function goCreate() : void {
		uni.navigateTo({
			url: '/pages/repair/create'
		})
	}
</script>

