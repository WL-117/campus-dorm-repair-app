<template>
	<!-- #ifdef APP && !VUE3-VAPOR -->
	<scroll-view class="page-scroll" :scroll-y="true" :bounces="false">
	<!-- #endif -->

	<view class="page">
		<!-- 用户卡片 -->
		<view class="header">
			<view class="avatar-wrap" @click="chooseAvatar">
				<image class="avatar-img" v-if="avatar.length > 0" :src="avatar" mode="aspectFill"></image>
				<text class="avatar-text" v-else>{{avatarText}}</text>
			</view>
			<view class="name-row">
				<text class="nickname">{{nickname}}</text>
				<text class="role-badge" v-if="isAdminRole">管理员</text>
			</view>
			<text class="account">账号：{{username}}</text>
			<text class="cache-tip">头像 / 昵称 / 手机号均保存在本地缓存，下次启动自动恢复</text>
			</view>

			<!-- 管理员入口：仅管理员账号可见 -->
			<view class="admin-entry" v-if="isAdminRole" @click="goAdmin">
			<view class="admin-icon">
				<text class="admin-icon-text">管</text>
			</view>
			<view class="admin-info">
				<text class="admin-title">管理控制台</text>
				<text class="admin-desc">工单受理 · 用户管理 · 发布公告</text>
			</view>
			<text class="admin-arrow">›</text>
			</view>

			<!-- 资料维护 -->
		<view class="card">
			<text class="card-title">个人资料</text>
			<view class="field">
				<text class="field-label">昵称</text>
				<input class="field-input" v-model="nickname" placeholder="请输入昵称" placeholder-class="ph" maxlength="12" />
			</view>
			<view class="field">
				<text class="field-label">手机号</text>
				<input class="field-input" v-model="phone" type="number" placeholder="请输入 11 位手机号" placeholder-class="ph" maxlength="11" />
			</view>
			<view class="field">
				<text class="field-label">宿舍</text>
				<input class="field-input" v-model="dorm" placeholder="如：A栋-305" placeholder-class="ph" maxlength="16" />
			</view>
			<view class="field">
				<text class="field-label">性别</text>
				<view class="gender-row">
					<view class="gender" :class="gender == item ? 'gender-on' : ''" v-for="(item, index) in genders" :key="index" @click="gender = item">
						<text class="gender-text" :class="gender == item ? 'gender-text-on' : ''">{{item}}</text>
					</view>
				</view>
			</view>
			<view class="save-btn" @click="saveProfile('资料已保存')">
				<text class="save-btn-text">保存资料</text>
			</view>
		</view>

		<!-- 功能菜单 -->
		<view class="card">
			<text class="card-title">我的服务</text>
			<view class="menu" @click="goMine">
				<text class="menu-text">我的报修记录</text>
				<text class="menu-arrow">›</text>
			</view>
			<view class="menu" @click="goHall">
				<text class="menu-text">报修大厅</text>
				<text class="menu-arrow">›</text>
			</view>
			<view class="menu" @click="goNotice">
				<text class="menu-text">公告中心</text>
				<text class="menu-arrow">›</text>
			</view>
			<view class="menu" @click="clearCache">
				<text class="menu-text">清除本地缓存</text>
				<text class="menu-arrow">›</text>
			</view>
		</view>

		<!-- 缓存信息 -->
		<view class="card">
			<text class="card-title">本地缓存信息</text>
			<view class="info-row">
				<text class="info-label">登录账号</text>
				<text class="info-value">{{username}}</text>
			</view>
			<view class="info-row">
				<text class="info-label">注册时间</text>
				<text class="info-value">{{createTime}}</text>
			</view>
			<view class="info-row">
				<text class="info-label">故障分类缓存</text>
				<text class="info-value">{{categoryCount}} 项</text>
			</view>
			<view class="info-row">
				<text class="info-label">报修草稿</text>
				<text class="info-value">{{draftTip}}</text>
			</view>
		</view>

		<view class="logout" @click="onLogout">
			<text class="logout-text">退出登录</text>
		</view>

		<view class="bottom"></view>
	</view>

	<!-- #ifdef APP && !VUE3-VAPOR -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { apiUpdateUser } from '../../common/api.uts'
	import { ApiResult } from '../../common/types.uts'
	import { toUserInfo } from '../../common/convert.uts'
	import { isPhone, toast, successToast, showLoading, hideLoading, confirmDialog } from '../../common/util.uts'
	import {
		getUser, saveUser, isLogin, isAdmin, getCategories, clearSession, clearCommonCache, hasDraft
	} from '../../common/store.uts'

	const genders : string[] = ['男', '女']
	const isAdminRole = ref(false)

	const username = ref('')
	const nickname = ref('')
	const phone = ref('')
	const dorm = ref('')
	const gender = ref('男')
	const avatar = ref('')
	const avatarText = ref('我')
	const createTime = ref('')
	const categoryCount = ref(0)
	const draftTip = ref('无')

	onPageShow(() => {
		if (!isLogin()) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return
		}
		loadUser()
	})

	function loadUser() : void {
		const u = getUser()
		username.value = u.username
		nickname.value = u.nickname
		phone.value = u.phone
		dorm.value = u.dorm
		gender.value = u.gender.length > 0 ? u.gender : '男'
		avatar.value = u.avatar
		createTime.value = u.createTime
		avatarText.value = nickname.value.length > 0 ? nickname.value.substring(0, 1) : '我'
		categoryCount.value = getCategories().length
		draftTip.value = hasDraft() ? '有未提交草稿' : '无'
		isAdminRole.value = isAdmin()
	}

	function goAdmin() : void {
		uni.navigateTo({
			url: '/pages/admin/index'
		})
	}

	function chooseAvatar() : void {
		uni.chooseImage({
			count: 1,
			sizeType: ['compressed'],
			sourceType: ['album', 'camera'],
			success: (res) => {
				const paths = res.tempFilePaths
				if (paths.length == 0) return
				avatar.value = paths[0]
				saveProfile('头像已更新')
			}
		})
	}

	function saveProfile(msg : string) : void {
		if (nickname.value.length == 0) {
			toast('昵称不能为空')
			return
		}
		if (!isPhone(phone.value)) {
			toast('请输入正确的 11 位手机号')
			return
		}
		showLoading('保存中')
		apiUpdateUser(nickname.value, phone.value, avatar.value, gender.value, dorm.value).then((res : ApiResult) => {
			hideLoading()
			if (res.code != 0) {
				toast(res.message)
				return
			}
			// 服务端返回最新用户信息，同步写入本地缓存
			const info = toUserInfo(res.data as UTSJSONObject)
			saveUser(info)
			loadUser()
			successToast(msg)
		})
	}

	function clearCache() : void {
		confirmDialog('清除缓存', '将清除报修草稿与常用数据缓存，确定继续吗？').then((confirm : boolean) => {
			if (!confirm) return
			clearCommonCache()
			categoryCount.value = 0
			draftTip.value = '无'
			successToast('缓存已清除')
		})
	}

	function goMine() : void {
		uni.navigateTo({
			url: '/pages/repair/mine'
		})
	}

	function goHall() : void {
		uni.switchTab({
			url: '/pages/repair/list'
		})
	}

	function goNotice() : void {
		uni.navigateTo({
			url: '/pages/notice/list'
		})
	}

	function onLogout() : void {
		confirmDialog('退出登录', '确定要退出当前账号吗？').then((confirm : boolean) => {
			if (!confirm) return
			clearSession()
			uni.reLaunch({
				url: '/pages/login/login'
			})
		})
	}
</script>

