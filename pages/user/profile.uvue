		padding: 50rpx 30rpx 44rpx 30rpx;
		background-image: linear-gradient(to bottom, #2b6cff, #5f92ff);
		flex-direction: column;
		align-items: center;
	}

	.name-row {
		margin-top: 20rpx;
		flex-direction: row;
		align-items: center;
	}

	.role-badge {
		margin-left: 14rpx;
		padding: 6rpx 18rpx;
		border-radius: 22rpx;
		background-color: rgba(255, 255, 255, 0.22);
		font-size: 21rpx;
		color: #ffffff;
	}

	.admin-entry {
		margin: 20rpx 24rpx 0 24rpx;
		padding: 24rpx;
		border-radius: 24rpx;
		background-image: linear-gradient(to right, #fff6ec, #ffe9d6);
		flex-direction: row;
		align-items: center;
	}

	.admin-icon {
		width: 80rpx;
		height: 80rpx;
