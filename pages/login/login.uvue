<template>
	<!-- #ifdef APP && !VUE3-VAPOR -->
	<scroll-view class="page-scroll" :scroll-y="true" :bounces="false">
	<!-- #endif -->

	<view class="page">
		<view class="top-bg"></view>

		<view class="content">
			<view class="logo-wrap">
				<text class="logo-text">宿</text>
			</view>
			<text class="app-name">校园宿舍报修</text>
			<text class="app-desc">在线提交 · 进度可查 · 省心生活</text>

			<view class="card">
				<view class="field">
					<text class="field-label">账号</text>
					<input class="field-input" v-model="account" placeholder="请输入学号 / 手机号" placeholder-class="ph" maxlength="20" />
				</view>
				<view class="divider"></view>
				<view class="field">
					<text class="field-label">密码</text>
					<input class="field-input" :password="true" v-model="password" placeholder="请输入登录密码" placeholder-class="ph" maxlength="18" />
				</view>
			</view>

			<view class="row">
				<view class="remember" @click="toggleRemember">
					<view class="check" :class="remember ? 'check-on' : ''">
						<text class="check-text" v-if="remember">√</text>
					</view>
					<text class="remember-text">记住账号</text>
					</view>
					<text class="demo" @click="useDemo">使用演示账号</text>
					</view>

					<view class="quick-row">
					<view class="quick-chip" @click="useDemo">
					<text class="quick-chip-text">学生 student</text>
					</view>
					<view class="quick-chip quick-chip-admin" @click="useAdmin">
					<text class="quick-chip-text quick-chip-text-admin">管理员 admin</text>
					</view>
					</view>

					<view class="btn-login" @click="onLogin">
				<text class="btn-login-text">登 录</text>
			</view>
			<view class="btn-register" @click="goRegister">
				<text class="btn-register-text">还没有账号？立即注册</text>
			</view>
		</view>

		<text class="tips">演示密码统一为 123456，点击上方标签可一键填入</text>
	</view>

	<!-- #ifdef APP && !VUE3-VAPOR -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { apiLogin } from '../../common/api.uts'
	import { ApiResult } from '../../common/types.uts'
	import { toUserInfo, objVal, strVal } from '../../common/convert.uts'
	import { toast, successToast, showLoading, hideLoading } from '../../common/util.uts'
	import {
		saveToken, saveUser, saveLastAccount, getLastAccount, getUser, getToken
	} from '../../common/store.uts'

	const account = ref('')
	const password = ref('')
	const remember = ref(true)

	onLoad((options : OnLoadOptions) => {
		// 本地缓存：回填上次登录账号
		const last = getLastAccount()
		if (last.length > 0) {
			account.value = last
			password.value = ''
		}
		// 本地缓存：已登录且凭证有效时免登录进入首页
		if (getToken().length > 0 && getUser().id.length > 0) {
			uni.switchTab({
				url: '/pages/index/index'
			})
		}
	})

	function toggleRemember() : void {
		remember.value = !remember.value
	}

	function useDemo() : void {
		account.value = 'student'
		password.value = '123456'
	}

	/** 一键填入管理员账号，登录后可在「我的」进入管理控制台 */
	function useAdmin() : void {
		account.value = 'admin'
		password.value = '123456'
	}

	function goRegister() : void {
		uni.navigateTo({
			url: '/pages/register/register'
		})
	}

	function onLogin() : void {
		const acc = account.value
		const pwd = password.value
		if (acc.length == 0) {
			toast('请输入账号')
			return
		}
		if (pwd.length == 0) {
			toast('请输入密码')
			return
		}
		if (pwd.length < 6) {
			toast('密码长度不能少于 6 位')
			return
		}

		showLoading('登录中')
		apiLogin(acc, pwd).then((res : ApiResult) => {
			hideLoading()
			if (res.code != 0) {
				toast(res.message)
				return
			}
			// 服务端返回：{ token, userInfo }
			const data = res.data as UTSJSONObject
			const token = strVal(data, 'token')
			const userInfo = toUserInfo(objVal(data, 'userInfo'))

			// 写入本地缓存
			saveToken(token)
			saveUser(userInfo)
			if (remember.value) {
				saveLastAccount(acc)
			}

			successToast('登录成功')
			setTimeout(() => {
				uni.switchTab({
					url: '/pages/index/index'
				})
			}, 600)
		})
	}
</script>

