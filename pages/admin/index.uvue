<template>
	<!-- #ifdef APP && !VUE3-VAPOR -->
	<scroll-view class="page-scroll" :scroll-y="true" :bounces="false">
	<!-- #endif -->

	<view class="page">
		<!-- 管理员身份卡片 -->
		<view class="hero">
			<view class="hero-top">
				<view class="hero-avatar">
					<text class="hero-avatar-text">管</text>
				</view>
				<view class="hero-info">
					<text class="hero-name">{{adminName}}</text>
					<text class="hero-sub">宿舍管理中心 · 系统管理员</text>
				</view>
				<view class="role-badge">
					<text class="role-badge-text">管理员</text>
				</view>
			</view>

			<view class="hero-card">
				<view class="hero-cell" @click="goOrders('0')">
					<text class="hero-num color-pending">{{stat.pending}}</text>
					<text class="hero-label">待受理</text>
				</view>
				<view class="hero-split"></view>
				<view class="hero-cell" @click="goOrders('1')">
					<text class="hero-num color-doing">{{stat.doing}}</text>
					<text class="hero-label">维修中</text>
				</view>
				<view class="hero-split"></view>
				<view class="hero-cell" @click="goOrders('2')">
					<text class="hero-num color-done">{{stat.done}}</text>
					<text class="hero-label">已完成</text>
				</view>
			</view>
		</view>

		<!-- 平台数据 -->
		<view class="section">
			<view class="section-head">
				<text class="section-bar"></text>
				<text class="section-title">平台数据</text>
			</view>
			<view class="stat-grid">
				<view class="stat-box">
					<text class="stat-box-num">{{stat.orders}}</text>
					<text class="stat-box-label">工单总数</text>
				</view>
				<view class="stat-box">
					<text class="stat-box-num">{{stat.users}}</text>
					<text class="stat-box-label">注册用户</text>
				</view>
				<view class="stat-box">
					<text class="stat-box-num color-urgent">{{stat.urgent}}</text>
					<text class="stat-box-label">紧急工单</text>
				</view>
				<view class="stat-box">
					<text class="stat-box-num color-today">{{stat.todayOrders}}</text>
					<text class="stat-box-label">今日新增</text>
				</view>
				<view class="stat-box">
					<text class="stat-box-num">{{stat.students}}</text>
					<text class="stat-box-label">学生</text>
				</view>
				<view class="stat-box">
					<text class="stat-box-num">{{stat.admins}}</text>
					<text class="stat-box-label">管理员</text>
				</view>
				<view class="stat-box">
					<text class="stat-box-num">{{stat.canceled}}</text>
					<text class="stat-box-label">已取消</text>
				</view>
				<view class="stat-box">
					<text class="stat-box-num">{{stat.notices}}</text>
					<text class="stat-box-label">公告</text>
				</view>
			</view>
		</view>

		<!-- 快捷管理 -->
		<view class="section">
