				<text class="section-title">快捷管理</text>
			</view>
			<view class="entry-row">
				<view class="entry-card" @click="goOrders('')">
					<view class="entry-icon entry-icon-1">
						<text class="entry-icon-text">单</text>
					</view>
					<text class="entry-name">工单管理</text>
					<text class="entry-desc">受理 / 完成 / 备注</text>
				</view>
				<view class="entry-card" @click="goUsers">
