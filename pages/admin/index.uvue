	<!-- #ifdef APP && !VUE3-VAPOR -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { apiAdminStat, apiAdminOrderList, apiAdminUpdateStatus } from '../../common/api.uts'
	import { AdminStat, RepairOrder, ApiResult } from '../../common/types.uts'
	import { toAdminStat, plainToOrder, arrayVal } from '../../common/convert.uts'
	import { toast, successToast, confirmDialog } from '../../common/util.uts'
	import { getUser, isLogin, isAdmin } from '../../common/store.uts'

	const adminName = ref('宿舍管理中心')
	const stat = ref<AdminStat>({
		users: 0,
		students: 0,
		admins: 0,
		orders: 0,
		pending: 0,
		doing: 0,
		done: 0,
		canceled: 0,
		urgent: 0,
		todayOrders: 0,
		notices: 0
	})
	const pendingList = ref<RepairOrder[]>([])

	onPageShow(() => {
		if (!isLogin()) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return
		}
		if (!isAdmin()) {
			toast('仅管理员可进入管理控制台')
			uni.navigateBack()
			return
		}
		const u = getUser()
		adminName.value = u.nickname.length > 0 ? u.nickname : u.username
		loadStat()
		loadPending()
	})

	function loadStat() : void {
		apiAdminStat().then((res : ApiResult) => {
			if (res.code != 0) {
				toast(res.message)
				return
			}
			stat.value = toAdminStat(res.data as UTSJSONObject)
		})
	}

	function loadPending() : void {
		apiAdminOrderList(1, 5, '0', '').then((res : ApiResult) => {
			if (res.code != 0) return
			const d = res.data as UTSJSONObject
			const arr = arrayVal(d, 'list')
			const list : RepairOrder[] = []
			for (let i = 0; i < arr.length; i++) {
				list.push(plainToOrder(arr[i]))
			}
			pendingList.value = list
		})
	}

	function accept(id : string) : void {
		confirmDialog('受理工单', '确认受理该报修工单并指派维修师傅？').then((yes : boolean) => {
			if (!yes) return
			apiAdminUpdateStatus(id, '1').then((res : ApiResult) => {
				if (res.code != 0) {
					toast(res.message)
					return
				}
				successToast('已受理')
				loadStat()
				loadPending()
			})
		})
	}

	function goOrders(status : string) : void {
		uni.navigateTo({
			url: '/pages/admin/orders?status=' + status
		})
	}

	function goUsers() : void {
		uni.navigateTo({
			url: '/pages/admin/users'
		})
	}

	function goNotices() : void {
		uni.navigateTo({
			url: '/pages/admin/notices'
		})
	}

	function openDetail(id : string) : void {
		uni.navigateTo({
			url: '/pages/repair/detail?id=' + id
		})
	}
</script>

