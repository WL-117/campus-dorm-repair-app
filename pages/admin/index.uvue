				</view>
			</view>
		</view>

		<!-- 待处理工单 -->
		<view class="section">
			<view class="section-head">
				<text class="section-bar"></text>
				<text class="section-title">待处理工单</text>
				<text class="section-more" @click="goOrders('0')">全部 ›</text>
			</view>

			<view class="card" v-if="pendingList.length > 0">
				<view class="order-item" v-for="item in pendingList" :key="item.id">
					<view class="order-head">
						<text class="order-cat">{{item.category}}</text>
						<text class="level-tag" v-if="item.level == '紧急'">紧急</text>
					</view>
					<text class="order-desc">{{item.description}}</text>
					<view class="order-meta">
						<text class="order-place">{{item.building}}-{{item.room}}</text>
						<text class="order-user">{{item.userName}}</text>
						<text class="order-time">{{item.createTime}}</text>
					</view>
					<view class="order-actions">
						<view class="mini-btn" @click="accept(item.id)">
							<text class="mini-btn-text">立即受理</text>
						</view>
						<view class="mini-btn mini-btn-plain" @click="openDetail(item.id)">
							<text class="mini-btn-plain-text">查看详情</text>
						</view>
