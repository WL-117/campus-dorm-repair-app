		border-radius: 18rpx;
		padding: 26rpx 0;
	}

	.quick-item {
		flex: 1;
		flex-direction: column;
		align-items: center;
	}

	.quick-icon {
		width: 88rpx;
		height: 88rpx;
		border-radius: 24rpx;
		justify-content: center;
		align-items: center;
	}

	.icon-1 {
		background-color: #e8f0ff;
	}

	.icon-2 {
		background-color: #fff1e6;
	}

	.icon-3 {
		background-color: #e8f7ee;
	}

	.icon-4 {
		background-color: #f3e8ff;
	}

	.quick-icon-text {
		font-size: 38rpx;
		font-weight: bold;
		color: #2b6cff;
	}

