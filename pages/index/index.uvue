<template>
	<!-- #ifdef APP && !VUE3-VAPOR -->
	<scroll-view class="page-scroll" :scroll-y="true" :bounces="false">
	<!-- #endif -->

	<view class="page">
		<!-- 顶部用户信息 + 工单统计 -->
		<view class="header">
			<view class="user-row" @click="goProfile">
				<view class="avatar">
					<image class="avatar-img" v-if="avatar.length > 0" :src="avatar" mode="aspectFill"></image>
					<text class="avatar-text" v-else>{{avatarText}}</text>
				</view>
				<view class="user-info">
					<text class="nickname">{{greeting}}，{{nickname}}</text>
					<text class="dorm">{{dormText}}</text>
				</view>
				<text class="arrow">›</text>
			</view>

			<view class="stat-card">
				<view class="stat-item" @click="goMine('')">
					<text class="stat-num">{{total}}</text>
					<text class="stat-label">全部工单</text>
				</view>
				<view class="stat-line"></view>
				<view class="stat-item" @click="goMine('0')">
					<text class="stat-num color-pending">{{pending}}</text>
					<text class="stat-label">待处理</text>
				</view>
				<view class="stat-line"></view>
				<view class="stat-item" @click="goMine('1')">
					<text class="stat-num color-doing">{{doing}}</text>
					<text class="stat-label">维修中</text>
				</view>
				<view class="stat-line"></view>
				<view class="stat-item" @click="goMine('2')">
					<text class="stat-num color-done">{{done}}</text>
					<text class="stat-label">已完成</text>
				</view>
			</view>
		</view>

		<!-- 快捷服务 -->
		<view class="section">
			<view class="section-head">
				<text class="section-bar"></text>
				<text class="section-title">快捷服务</text>
			</view>
			<view class="quick-grid">
				<view class="quick-item" @click="goCreate">
					<view class="quick-icon icon-1">
						<text class="quick-icon-text">修</text>
					</view>
					<text class="quick-text">我要报修</text>
				</view>
				<view class="quick-item" @click="goMine('')">
					<view class="quick-icon icon-2">
						<text class="quick-icon-text">单</text>
					</view>
					<text class="quick-text">我的报修</text>
				</view>
				<view class="quick-item" @click="goHall">
					<view class="quick-icon icon-3">
						<text class="quick-icon-text">厅</text>
					</view>
					<text class="quick-text">报修大厅</text>
				</view>
				<view class="quick-item" @click="goNoticeList">
					<view class="quick-icon icon-4">
						<text class="quick-icon-text">告</text>
					</view>
					<text class="quick-text">公告中心</text>
				</view>
			</view>
		</view>

		<!-- 报修公告 -->
		<view class="section">
			<view class="section-head">
				<text class="section-title">报修公告</text>
				<text class="more" @click="goNoticeList">更多 ›</text>
			</view>
			<view class="notice-card">
				<view class="notice-item" v-for="(item, index) in notices" :key="item.id" @click="openNotice(item.id)">
					<text class="notice-tag">{{item.tag}}</text>
					<text class="notice-title">{{item.title}}</text>
					<text class="notice-time">{{item.time}}</text>
				</view>
				<view class="empty" v-if="notices.length == 0">
					<view class="empty-icon">
						<text class="empty-icon-text">告</text>
					</view>
					<text class="empty-title">暂无公告</text>
				</view>
			</view>
		</view>

		<!-- 常见故障提示 -->
		<view class="section">
			<view class="section-head">
				<text class="section-bar"></text>
				<text class="section-title">常见故障自助处理</text>
			</view>
			<view class="tip-card">
				<view class="tip-item" v-for="(item, index) in tips" :key="index">
					<text class="tip-title">{{item.title}}</text>
					<text class="tip-desc">{{item.desc}}</text>
				</view>
				<view class="empty" v-if="tips.length == 0">
					<view class="empty-icon">
						<text class="empty-icon-text">助</text>
					</view>
					<text class="empty-title">暂无自助处理提示</text>
				</view>
			</view>
		</view>

		<view class="bottom"></view>
	</view>

	<!-- #ifdef APP && !VUE3-VAPOR -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { apiStat, apiNoticeList, apiTips, apiCategories } from '../../common/api.uts'
	import { ApiResult, Notice, FaultTip } from '../../common/types.uts'
	import { plainToNotice, plainToTip, arrayVal, numVal } from '../../common/convert.uts'
	import { toast } from '../../common/util.uts'
	import {
		getUser, isLogin, getTips, saveTips, getCategories, saveCategories
	} from '../../common/store.uts'

	const nickname = ref('同学')
	const dormText = ref('未填写宿舍')
	const avatar = ref('')
	const avatarText = ref('同')
	const greeting = ref('你好')

	const total = ref(0)
	const pending = ref(0)
	const doing = ref(0)
	const done = ref(0)

	const notices = ref<Notice[]>([])
	const tips = ref<FaultTip[]>([])

	onPageShow(() => {
		if (!isLogin()) {
			uni.reLaunch({
				url: '/pages/login/login'
			})
			return
		}
		loadUser()
		loadStat()
		loadNotices()
		loadTips()
		loadCategories()
	})

	function loadUser() : void {
		const u = getUser()
		if (u.id.length > 0) {
			nickname.value = u.nickname.length > 0 ? u.nickname : u.username
			dormText.value = u.dorm.length > 0 ? u.dorm : '未填写宿舍'
			avatar.value = u.avatar
			avatarText.value = nickname.value.substring(0, 1)
		}
		const hour = new Date().getHours()
		if (hour < 6) greeting.value = '凌晨好'
		else if (hour < 11) greeting.value = '早上好'
		else if (hour < 14) greeting.value = '中午好'
		else if (hour < 18) greeting.value = '下午好'
		else greeting.value = '晚上好'
	}

	function loadStat() : void {
		apiStat().then((res : ApiResult) => {
			if (res.code != 0) return
			const d = res.data as UTSJSONObject
			total.value = numVal(d, 'total')
			pending.value = numVal(d, 'pending')
			doing.value = numVal(d, 'doing')
			done.value = numVal(d, 'done')
		})
	}

	function loadNotices() : void {
		apiNoticeList().then((res : ApiResult) => {
			if (res.code != 0) {
				toast(res.message)
				return
			}
			const d = res.data as UTSJSONObject
			const arr = arrayVal(d, 'list')
			const list : Notice[] = []
			for (let i = 0; i < arr.length && i < 3; i++) {
				list.push(plainToNotice(arr[i]))
			}
			notices.value = list
		})
	}

	function loadTips() : void {
		// 优先读取本地缓存的常用数据，再向服务端同步
		const cached = getTips()
		if (cached.length > 0) {
			tips.value = cached
		}
		apiTips().then((res : ApiResult) => {
			if (res.code != 0) return
			const d = res.data as UTSJSONObject
			const arr = arrayVal(d, 'list')
			const list : FaultTip[] = []
			for (let i = 0; i < arr.length; i++) {
				list.push(plainToTip(arr[i]))
			}
			tips.value = list
			saveTips(list)
		})
	}

	function loadCategories() : void {
		// 故障分类同样属于常用数据，首次拉取后写入本地缓存
		apiCategories().then((res : ApiResult) => {
			if (res.code != 0) return
			const d = res.data as UTSJSONObject
			const arr = arrayVal(d, 'list')
			const list : string[] = []
			for (let i = 0; i < arr.length; i++) {
				list.push(arr[i]['name'] as string)
			}
			if (list.length > 0) saveCategories(list)
			getCategories()
		})
	}

	function goProfile() : void {
		uni.switchTab({
			url: '/pages/user/profile'
		})
	}

	function goCreate() : void {
		uni.navigateTo({
			url: '/pages/repair/create'
		})
	}

	function goMine(status : string) : void {
		uni.navigateTo({
			url: '/pages/repair/mine?status=' + status
		})
	}

	function goHall() : void {
		uni.switchTab({
			url: '/pages/repair/list'
		})
	}

	function goNoticeList() : void {
		uni.navigateTo({
			url: '/pages/notice/list'
		})
	}

	function openNotice(id : string) : void {
		uni.navigateTo({
			url: '/pages/notice/detail?id=' + id
		})
	}
</script>

<style>
	page {
		background-color: #f4f6fa;
	}

	.page {
		flex-direction: column;
		background-color: #f4f6fa;
	}

