	}

	.empty-text {
		font-size: 25rpx;
		color: #b6bdc9;
	}

	.bottom {
		height: 40rpx;
	}

	/* ---------------- 视觉优化 ---------------- */
	.header {
		background-image: linear-gradient(to bottom, #2b6cff, #5f92ff);
	}

	.stat-card {
		border-radius: 24rpx;
		box-shadow: 0 8rpx 24rpx rgba(43, 108, 255, 0.12);
	}

	.quick-grid {
		border-radius: 24rpx;
	}

	.notice-card {
		border-radius: 24rpx;
	}

	.tip-card {
		border-radius: 24rpx;
	}

	.quick-icon {
		border-radius: 28rpx;
	}

	.section-bar {
		width: 8rpx;
		height: 28rpx;
