		padding: 6rpx 26rpx 20rpx 26rpx;
	}

	.tip-item {
		padding: 18rpx 0;
		border-bottom-width: 1rpx;
		border-bottom-color: #f4f5f8;
		border-bottom-style: solid;
		flex-direction: column;
	}

	.tip-title {
		font-size: 27rpx;
