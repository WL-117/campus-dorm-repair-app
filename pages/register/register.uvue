<template>
	<!-- #ifdef APP && !VUE3-VAPOR -->
	<scroll-view class="page-scroll" :scroll-y="true" :bounces="false">
	<!-- #endif -->

	<view class="page">
		<view class="top-bg"></view>

		<view class="content">
			<text class="title">注册学生账号</text>
			<text class="sub-title">填写基本信息，享受便捷宿舍报修服务</text>

			<view class="card">
				<view class="field">
					<text class="field-label">账号</text>
					<input class="field-input" v-model="username" placeholder="4-16 位字母 / 数字 / 下划线" placeholder-class="ph" maxlength="16" />
				</view>
				<view class="field">
					<text class="field-label">昵称</text>
					<input class="field-input" v-model="nickname" placeholder="请输入昵称（可留空）" placeholder-class="ph" maxlength="12" />
				</view>
				<view class="field">
					<text class="field-label">手机号</text>
					<input class="field-input" v-model="phone" type="number" placeholder="请输入 11 位手机号" placeholder-class="ph" maxlength="11" />
				</view>
				<view class="field">
					<text class="field-label">密码</text>
					<input class="field-input" :password="true" v-model="password" placeholder="6-18 位字母 / 数字 / 下划线" placeholder-class="ph" maxlength="18" />
				</view>
				<view class="field">
					<text class="field-label">确认密码</text>
					<input class="field-input" :password="true" v-model="confirmPwd" placeholder="请再次输入密码" placeholder-class="ph" maxlength="18" />
				</view>
			</view>

			<view class="card">
				<text class="card-label">性别</text>
				<view class="tag-row">
					<view class="tag" :class="gender == item ? 'tag-on' : ''" v-for="(item, index) in genders" :key="index" @click="gender = item">
						<text class="tag-text" :class="gender == item ? 'tag-text-on' : ''">{{item}}</text>
					</view>
				</view>

				<text class="card-label">宿舍信息</text>
				<view class="field">
					<text class="field-label">楼栋</text>
					<input class="field-input" v-model="building" placeholder="如：A栋" placeholder-class="ph" maxlength="10" />
				</view>
				<view class="field">
					<text class="field-label">宿舍号</text>
					<input class="field-input" v-model="room" type="number" placeholder="如：305" placeholder-class="ph" maxlength="5" />
				</view>
			</view>

			<view class="btn-register" @click="onRegister">
				<text class="btn-register-text">注册并登录</text>
			</view>
			<view class="btn-back" @click="goLogin">
				<text class="btn-back-text">已有账号？返回登录</text>
			</view>
		</view>
	</view>

	<!-- #ifdef APP && !VUE3-VAPOR -->
	</scroll-view>
	<!-- #endif -->
</template>

<script setup lang="uts">
	import { apiRegister } from '../../common/api.uts'
	import { ApiResult } from '../../common/types.uts'
	import { isAccount, isPassword, isPhone, toast, successToast, showLoading, hideLoading } from '../../common/util.uts'
	import { saveLastAccount } from '../../common/store.uts'

	const genders : string[] = ['男', '女']

	const username = ref('')
	const nickname = ref('')
	const phone = ref('')
	const password = ref('')
	const confirmPwd = ref('')
	const gender = ref('男')
	const building = ref('')
	const room = ref('')

	function goLogin() : void {
		uni.navigateBack()
	}

	function onRegister() : void {
		const acc = username.value
		const pwd = password.value
		const cfm = confirmPwd.value
		const tel = phone.value

		if (!isAccount(acc)) {
			toast('账号为 4-16 位字母、数字或下划线')
			return
		}
		if (!isPhone(tel)) {
			toast('请输入正确的 11 位手机号')
			return
		}
		if (!isPassword(pwd)) {
			toast('密码为 6-18 位字母、数字或下划线')
			return
		}
		if (pwd != cfm) {
			toast('两次输入的密码不一致')
			return
		}
		if (building.value.length == 0) {
			toast('请输入宿舍楼栋')
			return
		}
		if (room.value.length == 0) {
			toast('请输入宿舍号')
			return
		}

		const dorm = building.value + '-' + room.value
		showLoading('提交中')
		apiRegister(acc, pwd, nickname.value, tel, gender.value, dorm).then((res : ApiResult) => {
			hideLoading()
			if (res.code != 0) {
				toast(res.message)
				return
			}
			saveLastAccount(acc)
			successToast('注册成功')
			setTimeout(() => {
				uni.navigateBack()
			}, 800)
		})
	}
</script>

<style>
	page {
		background-color: #f4f6fa;
	}

	.page {
		flex-direction: column;
		align-items: center;
		background-color: #f4f6fa;
	}

	.top-bg {
		position: absolute;
		left: 0;
		top: 0;
		width: 750rpx;
		height: 300rpx;
		background-color: #2b6cff;
	}

	.content {
		flex-direction: column;
		align-items: center;
		width: 750rpx;
		padding-top: 70rpx;
		padding-bottom: 60rpx;
	}

	.title {
		font-size: 40rpx;
		color: #ffffff;
		font-weight: bold;
	}

	.sub-title {
		margin-top: 12rpx;
		font-size: 24rpx;
		color: #d9e4ff;
	}

	.card {
		width: 660rpx;
		margin-top: 36rpx;
		padding: 10rpx 30rpx 24rpx 30rpx;
		background-color: #ffffff;
		border-radius: 20rpx;
		flex-direction: column;
	}

	.field {
		height: 104rpx;
		flex-direction: row;
		align-items: center;
		border-bottom-width: 1rpx;
		border-bottom-color: #f2f3f6;
		border-bottom-style: solid;
	}

	.field-label {
		width: 130rpx;
		font-size: 28rpx;
		color: #1f2329;
	}

	.field-input {
		flex: 1;
		height: 100rpx;
		font-size: 28rpx;
		color: #1f2329;
	}

	.ph {
		color: #b6bdc9;
		font-size: 27rpx;
	}

	.card-label {
		margin-top: 24rpx;
		margin-bottom: 16rpx;
		font-size: 28rpx;
		color: #1f2329;
		font-weight: bold;
	}

	.tag-row {
		flex-direction: row;
		align-items: center;
	}

	.tag {
		padding: 12rpx 40rpx;
		margin-right: 20rpx;
		border-radius: 30rpx;
		background-color: #f3f5f9;
	}

	.tag-on {
		background-color: #e8f0ff;
		border-width: 2rpx;
		border-color: #2b6cff;
		border-style: solid;
		padding: 10rpx 38rpx;
	}

	.tag-text {
		font-size: 26rpx;
		color: #6b7280;
	}

	.tag-text-on {
		color: #2b6cff;
		font-weight: bold;
	}

	.btn-register {
		width: 660rpx;
		height: 92rpx;
		margin-top: 46rpx;
		border-radius: 46rpx;
		background-color: #2b6cff;
		justify-content: center;
		align-items: center;
	}

	.btn-register-text {
		font-size: 32rpx;
		color: #ffffff;
		font-weight: bold;
	}

	.btn-back {
		margin-top: 30rpx;
		padding: 10rpx 30rpx;
	}

	.btn-back-text {
		font-size: 27rpx;
		color: #2b6cff;
	}
	/* ---------------- 视觉优化 ---------------- */
	.top-bg {
		background-image: linear-gradient(to bottom, #2b6cff, #6a9bff);
	}

	.card {
		border-radius: 24rpx;
	}

	.field-input {
		height: 84rpx;
		padding: 0 20rpx;
		border-radius: 16rpx;
		background-color: #f7f9fc;
		font-size: 27rpx;
	}

	.tag {
		padding: 12rpx 28rpx;
		border-radius: 30rpx;
	}

	.btn-register {
		height: 92rpx;
		border-radius: 46rpx;
		background-image: linear-gradient(to right, #2b6cff, #5f92ff);
	}
</style>
